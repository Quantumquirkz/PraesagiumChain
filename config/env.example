# PraesagiumChain — Environment (copy to .env at repo root)

# Backend
PORT=4000
# SQLite for local dev (zero-config). File created on first run (path relative to cwd).
DATABASE_URL=sqlite:./praesagium.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/praesagium
# DB_POOL_SIZE=10              # max connections (default 10)
# PREDICTION_CACHE_TTL=300     # prediction cache TTL seconds (default 300)
# RATE_LIMIT_PER_SECOND=60     # per-IP rate limit (default 60)
# RATE_LIMIT_BURST=30          # per-IP burst size (default 30)
# CORS: comma-separated origins (production). If unset, allows all.
# CORS_ORIGINS=https://yourapp.vercel.app,http://localhost:3000
# Production: set to "production" to require JWT_SECRET.
# ENVIRONMENT=production
# SIWE nonces: Redis URL for production (shared across instances). If unset, nonces are in-memory.
# REDIS_URL=redis://localhost:6379

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Chain / Indexer (optional). Leave unset or empty to run without indexer.
# If set, both must be non-empty and valid (address = 0x + 40 hex).
# RUN_INDEXER_ONLY=1 runs only the indexer (no API); requires both RPC_URL and PREDICTION_MARKET_ADDRESS.
RPC_URL=
PREDICTION_MARKET_ADDRESS=
START_BLOCK=

# Chainlink Functions (optional, for deployWithFunctions.js)
FUNCTIONS_ROUTER=

# API-Football (optional, for /api/sports/winner)
# API_FOOTBALL_KEY=
# Finnhub (optional, for /api/sources/fetch?source=finnhub)
# FINNHUB_API_KEY=
# Hardhat & testnet
PRIVATE_KEY=
# Sepolia (for deploy & verify). Public RPC can timeout; prefer Alchemy:
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Get API key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Optional: Polygon Amoy
# POLYGON_RPC_URL=...
# POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGONSCAN_API_KEY=

# After deploy (fill for verify script, backend indexer, demo)
# PREDICTION_MARKET_ADDRESS=
# CRE_WORKFLOW_ADDRESS=
# ORACLE_CONSUMER_ADDRESS=
# API_BASE_URL=http://localhost:4000  # for resolveFromBackend / demo
# Private Prediction Markets (npm run deploy:private)
# PRIVATE_PREDICTION_MARKET_ADDRESS=
# PRIVATE_CRE_WORKFLOW_ADDRESS=
# PRIVATE_ORACLE_CONSUMER_ADDRESS=

