# PraesagiumChain — Environment (copy to .env at repo root)
# Stack: PostgreSQL + Redis. Red por defecto: Sepolia testnet.

# Backend
PORT=4000
# PostgreSQL (recomendado). Redis para caché/sesiones (REDIS_URL).
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/praesagium
# REDIS_URL=redis://localhost:6379
# Rate limit: más permisivo por defecto para evitar "Too Many Requests" en desarrollo.
# RATE_LIMIT_PER_SECOND=600
# RATE_LIMIT_BURST=400
# DB_POOL_SIZE=10              # max connections (default 10)
# PREDICTION_CACHE_TTL=300     # prediction cache TTL seconds (default 300)
# RATE_LIMIT_PER_SECOND=60     # per-IP rate limit (default 60)
# CORS: comma-separated origins (production). If unset, backend uses permissive CORS.
# CORS_ORIGINS=https://yourapp.vercel.app,http://localhost:3000
# Production: set ENVIRONMENT=production and a strong JWT_SECRET.
# ENVIRONMENT=development
# ENVIRONMENT=production
# JWT_SECRET=your-long-random-secret

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Chain — Sepolia testnet (indexer y scripts)
# RPC y contrato deben ser de Sepolia. Rellena PREDICTION_MARKET_ADDRESS tras desplegar.
# IMPORTANTE: Backend usa PREDICTION_MARKET_ADDRESS; el frontend usa NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS.
# Ambos deben apuntar al mismo contrato en la misma red (p. ej. Sepolia).
RPC_URL=https://rpc.sepolia.org
PREDICTION_MARKET_ADDRESS=
START_BLOCK=

# Chainlink Functions (optional, for deployWithFunctions.js)
FUNCTIONS_ROUTER=

# Chainlink Data Feeds (for /api/feeds/price and source=chainlink in /api/price/above)
# Sepolia: https://docs.chain.link/data-feeds/price-feeds/addresses
# CHAINLINK_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
# CHAINLINK_BTC_USD_FEED=0x1b44F3514812d835EB1BDB0acB33d3fA3351Ee43

# Chainlink Automation (Sepolia)
# AUTOMATION_REGISTRY=0x86EFBD0b6736Bed994962f9797049422A3A8E8Ad
# AUTOMATION_RESOLVER_ADDRESS=  # after deploy
# AUTOMATION_UPKEEP_ID=        # after npm run register:upkeep
# LINK_TOKEN=0x779877A7B0D9E8603169DdbD7836e478b4624789

# API-Football (optional, for /api/sports/winner)
# API_FOOTBALL_KEY=
# Finnhub (optional, for /api/sources/fetch?source=finnhub)
# FINNHUB_API_KEY=

# Hardhat — Sepolia testnet
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=

# Tras desplegar en Sepolia (npm run deploy:sepolia = deployWithFunctions.js)
# PREDICTION_MARKET_ADDRESS=0x...
# CRE_WORKFLOW_ADDRESS=0x...
# ORACLE_CONSUMER_ADDRESS=0x...
API_BASE_URL=http://localhost:4000
# Private Prediction Markets (npm run deploy:private)
# PRIVATE_PREDICTION_MARKET_ADDRESS=
# PRIVATE_CRE_WORKFLOW_ADDRESS=
# PRIVATE_ORACLE_CONSUMER_ADDRESS=

