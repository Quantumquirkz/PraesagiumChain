# PraesagiumChain - Environment (copy to .env)

# Backend
PORT=4000
DATABASE_URL=sqlite:./data/markets.db

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Chain/Indexer (optional)
RPC_URL=
PREDICTION_MARKET_ADDRESS=
START_BLOCK=

# Chainlink Functions (optional, for deployWithFunctions.js)
FUNCTIONS_ROUTER=

# API-Football (optional, for /api/sports/winner)
# API_FOOTBALL_KEY=

# Hardhat
PRIVATE_KEY=

# Supabase (frontend) - see config/FRONTEND-SETUP.md
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=...
