# PraesagiumChain — Environment (copy to .env at repo root)

# Backend
PORT=4000
# PostgreSQL (Supabase). Use Session pooler on IPv4-only networks (WSL, etc.):
#   Dashboard → Connect → Session pooler → copy URI (password: use %23 for #).
#   Host region must match your project (e.g. aws-0-us-west-2.pooler.supabase.com).
# Direct: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# CORS: comma-separated origins (production). If unset, allows all.
# CORS_ORIGINS=https://yourapp.vercel.app,http://localhost:3000

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Chain / Indexer (optional). Leave unset or empty to run without indexer.
# If set, both must be non-empty and valid (address = 0x + 40 hex).
RPC_URL=
PREDICTION_MARKET_ADDRESS=
START_BLOCK=

# Chainlink Functions (optional, for deployWithFunctions.js)
FUNCTIONS_ROUTER=

# API-Football (optional, for /api/sports/winner)
# API_FOOTBALL_KEY=

# Hardhat & testnet
PRIVATE_KEY=
# Sepolia (for deploy & verify)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Get API key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Optional: Polygon Amoy
# POLYGON_RPC_URL=...
# POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGONSCAN_API_KEY=

# After deploy (fill for verify script & backend indexer)
# PREDICTION_MARKET_ADDRESS=
# CRE_WORKFLOW_ADDRESS=
# ORACLE_CONSUMER_ADDRESS=

# Supabase (frontend) — optional; see config/frontend.env.example
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # server-only; never expose in frontend
