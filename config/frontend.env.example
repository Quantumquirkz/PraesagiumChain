# Copy to frontend/.env.local and fill with your values.
# See docs/frontend-project.md § 3.2 for details.

# Backend API: optional for local dev. If unset, the app uses the same-origin proxy
# (Next.js rewrites /api/* to BACKEND_URL in next.config.js). Set this only if you
# need the browser to call the backend URL directly (e.g. same host as backend).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Chain (required for wallet and contracts)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# Block explorer (optional - links for tx and addresses)
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# Private (commit-reveal) markets (optional - leave unset if not deployed)
# NEXT_PUBLIC_PRIVATE_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_PRIVATE_MARKET_IDS=1,2
