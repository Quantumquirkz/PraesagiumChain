# Copy to frontend/.env.local and fill with your Supabase project values.
# Get URL and anon key from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<your-anon-or-publishable-key>
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
