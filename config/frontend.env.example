# Copy to frontend/.env.local and fill with your values.
# Red por defecto: Sepolia testnet. Las apuestas usan Sepolia ETH (testnet).
# See docs/frontend-project.md § 3.2 and docs/keys-and-apis.md.

# Backend URL for Next.js server-side rewrites (next.config.js). Default: http://localhost:4000.
# BACKEND_URL=http://localhost:4000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Chain — Sepolia testnet (chainId 11155111) o local Hardhat (31337)
# Para aceptar ambas redes (wallet en Sepolia o en localhost), usa:
#   NEXT_PUBLIC_CHAIN_IDS=11155111,31337
# Si solo usas una red, puedes usar NEXT_PUBLIC_CHAIN_ID (ej. 11155111 o 31337).
NEXT_PUBLIC_CHAIN_ID=11155111
# NEXT_PUBLIC_CHAIN_IDS=11155111,31337
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# Private (commit-reveal) markets (optional)
# NEXT_PUBLIC_PRIVATE_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_PRIVATE_MARKET_IDS=1,2

# Chainlink Automation + Data Feeds (optional, reserved for future use)
# NEXT_PUBLIC_AUTOMATION_RESOLVER_ADDRESS=0x...
