# Example env when running backend inside Docker (e.g. docker compose run backend).
# Use hostnames: postgres, redis, clickhouse.
# For backend on host, use localhost in DATABASE_URL, REDIS_URL, CLICKHOUSE_URL.

DATABASE_URL=postgresql://praesagium:praesagium@postgres:5432/praesagium
REDIS_URL=redis://redis:6379
CLICKHOUSE_URL=http://clickhouse:8123

# Optional: same as root env.example for RPC, contracts, AI, etc.
# PORT=4000
# RPC_URL=https://rpc.sepolia.org
# PREDICTION_MARKET_ADDRESS=
# GEMINI_API_KEY=
